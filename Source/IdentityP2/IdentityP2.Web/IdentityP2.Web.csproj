<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OutputType>Library</OutputType>
        <RootNamespace>Identity.Web</RootNamespace>
        <Configurations>Release;Debug</Configurations>
        <Platforms>x86;x64</Platforms>
        <OutputPath>..\..\..\Build\$(Configuration)\IdentityP2\</OutputPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\IdentityP2.Data\IdentityP2.Data.csproj" />
      <ProjectReference Include="..\IdentityP2.Server\IdentityP2.Server.csproj" />
    </ItemGroup>

    <Import Project="..\..\Encore\Encore.Web\Encore.Web.projitems" Label="Shared" />

</Project>
