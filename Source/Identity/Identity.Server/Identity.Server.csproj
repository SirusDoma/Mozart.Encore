<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Configurations>Release;Debug</Configurations>
        <Platforms>x86;x64</Platforms>
        <RootNamespace>Mozart</RootNamespace>
        <AssemblyName>Identity.Server</AssemblyName>
        <InvariantGlobalization>false</InvariantGlobalization>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
        <OutputPath>..\..\..\Build\$(Configuration)\Identity\</OutputPath>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Identity.Data\Identity.Data.csproj" />
        <PackageReference Include="Microsoft.Extensions.Hosting" />
    </ItemGroup>

    <Import Project="..\..\Encore\Encore.Framework\Encore.Framework.projitems" Label="Shared" />
    <Import Project="..\..\Encore\Encore.Server\Encore.Server.projitems" Label="Shared" />

</Project>
