<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Uncomment these to go native
             You have to completely use function handler entirely without controllers

            <PublishAot>true</PublishAot>
            <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
            <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.Extensions.Configuration.Binder.SourceGeneration</InterceptorsNamespaces>
        -->
        <InvariantGlobalization>false</InvariantGlobalization>
        <Configurations>Release;Debug</Configurations>
        <Platforms>x86;x64</Platforms>
        <AssemblyName>Memoryer.Encore</AssemblyName>
        <ApplicationIcon>..\..\Encore\Mozart.ico</ApplicationIcon>
        <PackageId>Memoryer.Encore</PackageId>
        <Authors>Memoryer.Encore</Authors>
        <Company>Memoryer.Encore</Company>
        <Product>Memoryer.Encore</Product>
        <RootNamespace>Memoryer</RootNamespace>
        <OutputPath>..\..\..\Build\$(Configuration)\Memoryer\</OutputPath>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.Extensions.Configuration.Ini" />
      <PackageReference Include="Microsoft.Extensions.Hosting" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="System.CommandLine" />
    </ItemGroup>

    <ItemGroup>
      <None Update="config.ini">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="Itemdata.dat">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="OJNList.dat">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="AlbumList.ojs">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Memoryer.Server\Memoryer.Server.csproj" />
      <ProjectReference Include="..\Memoryer.Data\Memoryer.Data.csproj" />
      <ProjectReference Include="..\Memoryer.Migrations\MySql\Memoryer.Migrations.MySql.csproj" />
      <ProjectReference Include="..\Memoryer.Migrations\Postgres\Memoryer.Migrations.Postgres.csproj" />
      <ProjectReference Include="..\Memoryer.Migrations\Sqlite\Memoryer.Migrations.Sqlite.csproj" />
      <ProjectReference Include="..\Memoryer.Migrations\SqlServer\Memoryer.Migrations.SqlServer.csproj" />
      <ProjectReference Include="..\Memoryer.Relay\Memoryer.Relay.csproj" />
      <ProjectReference Include="..\Memoryer.Web\Memoryer.Web.csproj" />
    </ItemGroup>

    <Import Project="..\..\Encore\Encore.CLI\Encore.CLI.projitems" Label="Shared" />
</Project>
